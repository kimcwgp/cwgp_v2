<section class="how-it-works">

    <div class="container-step">

        <!-- Header -->
        <div class="section-header-step">

            <h2>{{ section.settings.heading }}</h2>

            <p>{{ section.settings.description }}</p>

        </div>

        <!-- Progress -->
        <div class="process-progress">

            {% for block in section.blocks %}

                <div class="step {% if forloop.first %}active{% endif %}">
                    <span>{{ forloop.index | prepend: '0' }}</span>
                </div>

                {% unless forloop.last %}
                    <div class="line {% if forloop.first %}active{% endif %}"></div>
                {% endunless %}

            {% endfor %}

        </div>

        <!-- Cards -->
        <div class="process-grid-step">

        {% for block in section.blocks %}

        <article class="process-card-step" {{ block.shopify_attributes }}>

            <div class="card-image-step">

                {% if block.settings.image %}

                    {{
                        block.settings.image
                        | image_url: width: 700
                        | image_tag:
                            loading: 'lazy',
                            alt: block.settings.title
                    }}

                {% endif %}

            </div>

            <div class="card-body">

                <div class="card-title">

                    <div class="icon-circle">

                        {% case block.settings.icon %}

                            {% when 'phone' %}

                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.09 4.18 2 2 0 0 1 4.08 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.61 2.62a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.46-1.15a2 2 0 0 1 2.11-.45c.84.28 1.72.49 2.62.61A2 2 0 0 1 22 16.92z"/>
                                </svg>

                            {% when 'search' %}

                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="7"/>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                                </svg>

                            {% when 'users' %}

                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                </svg>

                            {% when 'check' %}

                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>

                        {% endcase %}

                    </div>

                    <div>

                        <h3>{{ block.settings.title }}</h3>

                        <span class="gold-line"></span>

                    </div>

                </div>

                <p>

                    {{ block.settings.description }}

                </p>

            </div>

        </article>

        {% endfor %}

        </div>

        <!-- CTA -->
        <div
            class="process-cta"
            onclick="Calendly.initPopupWidget({url: 'https://calendly.com/kimson-pomento-cwglobalpeople/30min?hide_gdpr_banner=1'}); return false;"
            role="button"
            tabindex="0">

            <div class="cta-icon">

                <svg width="28"
                    height="28"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round">

                    <rect x="3" y="4" width="18" height="18" rx="2"/>

                    <line x1="16" y1="2" x2="16" y2="6"/>

                    <line x1="8" y1="2" x2="8" y2="6"/>

                    <line x1="3" y1="10" x2="21" y2="10"/>

                </svg>

            </div>

            <span class="cta-text">

                Ready to get started?

            </span>

            <span class="divider"></span>

            <span class="cta-link">

                Schedule a Call

                <span class="arrow">→</span>

            </span>

        </div>

    </div>

</section>

<style>

/*==================================================
VARIABLES
==================================================*/

:root{

    --primary:#17255A;

    --gold:#C79A45;

    --gold-light:#E7C97B;

    --text:#60677a;

    --heading:#17255A;

    --white:#ffffff;

    --border:#ececec;

    --bg:#f7f8fc;

    --shadow:

        0 10px 30px rgba(15,23,42,.05),

        0 25px 70px rgba(15,23,42,.07);

    --radius:22px;

    --transition:.35s ease;

}

/*==================================================
SECTION
==================================================*/

.how-it-works{

    padding:110px 30px;

    position:relative;

    overflow:hidden;

}

.how-it-works::before{

    content:"";

    position:absolute;

    inset:0;

    background:

    radial-gradient(

        circle at top center,

        rgba(23,37,90,.04),

        transparent 70%

    );

    pointer-events:none;

}

/*==================================================
CONTAINER
==================================================*/

.container-step{

    max-width:1450px;

    margin:auto;

    position:relative;

    z-index:2;

}

/*==================================================
HEADER
==================================================*/

.section-header-step{

    text-align:center;

    margin-bottom:65px;

}

.section-header-step h2{

    font-size:2rem;

    font-weight:700;

    line-height:1;

    letter-spacing:-2px;

    color:var(--heading);

    margin-bottom:25px;

}

.section-header-step p{

    max-width:720px;

    margin:auto;

    font-size:28px;

    line-height:1.7;

    color:var(--text);

}

/*==================================================
TIMELINE
==================================================*/

.process-progress{

    display:flex;

    align-items:center;

    justify-content:center;

    margin-bottom:70px;

}

.step{

    width:58px;

    height:58px;

    border-radius:50%;

    background:#f1f2f7;

    color:var(--heading);

    display:flex;

    align-items:center;

    justify-content:center;

    font-size:20px;

    font-weight:600;

    flex-shrink:0;

    transition:var(--transition);

}

.step.active{

    background:var(--primary);

    color:#fff;

    box-shadow:

        0 10px 30px rgba(23,37,90,.25);

}

.line{

    width:280px;

    height:3px;

    background:#dddddd;

    margin:0 18px;

    position:relative;

    overflow:hidden;

    border-radius:100px;

}

.line.active{

    background:#e2e2e2;

}

.line.active::after{

    content:"";

    position:absolute;

    left:0;

    top:0;

    width:100%;

    height:100%;

    background:

        linear-gradient(

            90deg,

            var(--gold),

            var(--gold-light)

        );

}

/*==================================================
COMMON TITLES
==================================================*/

.gold-line{

    display:block;

    width:58px;

    height:4px;

    margin-top:12px;

    border-radius:999px;

    background:

        linear-gradient(

            90deg,

            var(--gold),

            var(--gold-light)

        );

}

/*==================================================
IMAGE RESET
==================================================*/

img{

    display:block;

    width:100%;

    height:auto;

}

/*==================================================
LINKS
==================================================*/

a{

    text-decoration:none;

    color:inherit;

}

/*==================================================
UTILITY
==================================================*/

.hidden{

    display:none;

}
/*==================================================
PROCESS GRID
==================================================*/

.process-grid-step{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:30px;

    align-items:stretch;

    margin-bottom:70px;

}

/*==================================================
CARD
==================================================*/

.process-card-step{

    background:linear-gradient(
        180deg,
        #ffffff 0%,
        #fcfcfd 100%
    );

    border-radius:24px;

    overflow:hidden;

    position:relative;

    border:1px solid rgba(23,37,90,.05);

    box-shadow:var(--shadow);

    transition:
        transform .45s ease,
        box-shadow .45s ease;

    display:flex;

    flex-direction:column;

    height:100%;

}

.process-card-step:hover{

    transform:
        translateY(-10px);

    box-shadow:

        0 20px 45px rgba(15,23,42,.10),

        0 40px 90px rgba(15,23,42,.08);

}

/*==================================================
IMAGE
==================================================*/

.card-image-step{

    height:285px;

    overflow:hidden;
    aspect-ratio: 16 / 9;

    position:relative;

}

.-card-image-step::after{

    content:"";

    position:absolute;

    inset:0;

    background:

        linear-gradient(

            to top,

            rgba(0,0,0,.08),

            transparent 50%

        );

}

.card-image-step img{

    width:100%;

    height:100%;

    object-fit: cover;
    display: block;

    transition:
        transform .7s ease;

}

.process-card-step:hover
.card-image-step img{

    transform:scale(1.08);

}

/*==================================================
BODY
==================================================*/

.card-body{

    padding:34px;

    display:flex;

    flex-direction:column;

    flex:1;

}

/*==================================================
TITLE AREA
==================================================*/

.card-title{

    display:flex;

    align-items:flex-start;

    gap:18px;

    margin-bottom:28px;

}

/*==================================================
ICON
==================================================*/

.icon-circle{

    width:58px;

    height:58px;

    min-width:58px;

    border-radius:50%;

    background:#fbf7ef;

    color:var(--gold);

    display:flex;

    align-items:center;

    justify-content:center;

    transition:all .35s ease;

}

.icon-circle svg{

    width:26px;

    height:26px;

}

.process-card-step:hover
.icon-circle{

    background:var(--gold);

    color:#ffffff;

    transform:

        rotate(-8deg)

        scale(1.08);

}

/*==================================================
TITLE
==================================================*/

.card-title h3{

    font-size:25px;

    line-height:1.1;

    font-weight:700;

    color:var(--heading);

    margin-bottom:0;

    transition:.3s ease;

}

.process-card-step:hover
.card-title h3{

    color:var(--gold);

}

/*==================================================
DESCRIPTION
==================================================*/

.card-body p{

    font-size:18px;

    line-height:1.8;

    color:var(--text);

    margin-top:4px;

}

/*==================================================
CARD DECORATION
==================================================*/

.process-card-step::before{

    content:"";

    position:absolute;

    width:340px;

    height:340px;

    border-radius:50%;

    background:

        radial-gradient(

            circle,

            rgba(199,154,69,.05),

            transparent 70%

        );

    right:-170px;

    top:-170px;

    pointer-events:none;

}

.process-card-step::after{

    content:"";

    position:absolute;

    width:10px;

    height:10px;

    border-radius:50%;

    right:26px;

    top:26px;

    background:var(--gold);

    opacity:.18;

}

/*==================================================
HOVER GOLD LINE
==================================================*/

.process-card-step:hover
.gold-line{

    width:75px;

}

/*==================================================
SMOOTH ANIMATION
==================================================*/

.process-card-step,
.card-image-step img,
.icon-circle,
.gold-line,
.card-title h3{

    transition:all .35s ease;

}

/*==================================================
OPTIONAL STAGGER
==================================================*/

.process-card-step:nth-child(2){

    transition-delay:.05s;

}

.process-card-step:nth-child(3){

    transition-delay:.1s;

}

.process-card-step:nth-child(4){

    transition-delay:.15s;

}
/*==================================================
CALL TO ACTION
==================================================*/

.process-cta{
    cursor:pointer;
}

.process-cta{

    max-width:720px;

    margin:0 auto;

    background:linear-gradient(
        180deg,
        #ffffff,
        #fcfcfd
    );

    border:1px solid rgba(23,37,90,.06);

    border-radius:999px;

    padding:14px 18px;

    display:flex;

    align-items:center;

    justify-content:center;

    gap:20px;

    box-shadow:

        0 12px 35px rgba(15,23,42,.06);

    transition:all .35s ease;

}

.process-cta:hover{

    transform:translateY(-5px);

    box-shadow:

        0 20px 50px rgba(15,23,42,.10);

}

.cta-icon{

    width:52px;

    height:52px;

    border-radius:50%;

    display:flex;

    align-items:center;

    justify-content:center;

    background:#17255A;

    color:#ffffff;

    flex-shrink:0;

}

.cta-icon svg{

    width:24px;

    height:24px;

}

.cta-text{

    font-size:20px;

    font-weight:600;

    color:var(--heading);

    white-space:nowrap;

}

.divider{

    width:1px;

    height:32px;

    background:#e5e5e5;

}

.cta-link{

    display:flex;

    align-items:center;

    gap:10px;

    font-size:20px;

    font-weight:600;

    color:var(--gold);

    transition:all .3s ease;

}

.arrow{

    font-size:24px;

    transition:transform .3s ease;

}

.process-cta:hover .arrow{

    transform:translateX(8px);

}

.process-cta:hover .cta-link{

    color:#b88428;

}

/*==================================================
RESPONSIVE
==================================================*/

/* Large Desktop */

@media (max-width:1400px){

    .process-grid-step{

        gap:24px;

    }

    .section-header-step h2{

        font-size:60px;

    }

    .section-header-step p{

        font-size:24px;

    }

}

/* Laptop */

@media (max-width:1200px){

    .process-grid-step{

        grid-template-columns:repeat(2,1fr);

    }

    .line{

        width:160px;

    }

}

/* Tablet */

@media (max-width:992px){

    .how-it-works{

        padding:80px 20px;

    }

    .section-header-step h2{

        font-size:48px;

    }

    .section-header-step p{

        font-size:20px;

    }

    .process-progress{

        overflow-x:auto;

        justify-content:flex-start;

        padding-bottom:10px;

    }

    .line{

        width:120px;

    }

}

/* Mobile */

@media (max-width:768px){

    .process-grid-step{

        grid-template-columns:1fr;

    }

    .card-image-step{

        height:240px;

    }

    .process-cta{

        border-radius:26px;

        flex-direction:column;

        gap:15px;

        text-align:center;

        padding:28px;

    }

    .divider{

        display:none;

    }

    .cta-text{

        font-size:18px;

    }

    .cta-link{

        font-size:18px;

    }

}

/* Small Mobile */

@media (max-width:576px){

    .how-it-works{

        padding:60px 15px;

    }

    .-section-header-step-{

        margin-bottom:45px;

    }

    .section-header-step h2{

        font-size:38px;

    }

    .section-header-step p{

        font-size:17px;

    }

    .step{

        width:46px;

        height:46px;

        font-size:16px;

    }

    .line{

        width:80px;

        margin:0 12px;

    }

    .card-body{

        padding:24px;

    }

    .card-title h3{

        font-size:22px;

    }

    .card-body p{

        font-size:16px;

    }

}

/*==================================================
PREMIUM ANIMATIONS
==================================================*/

/* Initial State */

.process-card,
.process-progress,
.process-cta,
.section-header-step{

    opacity:0;

    transform:translateY(40px);

}

/* Visible State */

.fade-in{

    opacity:1 !important;

    transform:translateY(0) !important;

    transition:

        opacity .8s ease,

        transform .8s ease;

}

/* Stagger Animation */

.process-card-step:nth-child(1){

    transition-delay:.10s;

}

.process-card-step:nth-child(2){

    transition-delay:.20s;

}

.process-card-step:nth-child(3){

    transition-delay:.30s;

}

.process-card-step:nth-child(4){

    transition-delay:.40s;

}

/* Card Glow */

.process-card-step:hover{

    box-shadow:

        0 18px 40px rgba(23,37,90,.08),

        0 35px 90px rgba(23,37,90,.12);

}

/* Floating Image */

.process-card-step:hover .card-image-step img{

    transform:

        scale(1.06)

        translateY(-6px);

}

/* Icon Animation */

.process-card-step:hover .icon-circle{

    transform:

        scale(1.08)

        rotate(-10deg);

}

/* Gold Line */

.process-card-step:hover .gold-line{

    width:80px;

}

/* CTA Animation */

.process-cta{

    transition:

        transform .35s ease,

        box-shadow .35s ease;

}

.process-cta:hover{

    transform:translateY(-5px);

}

.process-cta:hover .arrow{

    transform:translateX(8px);

}

/* Progress Step */

.step{

    transition:

        background .35s ease,

        color .35s ease,

        transform .35s ease;

}

.step.active{

    transform:scale(1.08);

}

/* Card Overlay */

.card-image-step{

    position:relative;

}

.card-image-step::before{

    content:"";

    position:absolute;

    inset:0;

    background:

        linear-gradient(

            rgba(0,0,0,0),

            rgba(0,0,0,.08)

        );

    opacity:0;

    transition:.4s;

}

.process-card-step:hover .card-image-step::before{

    opacity:1;

}

/* Accessibility */

@media (prefers-reduced-motion: reduce){

    *{

        animation:none !important;

        transition:none !important;

        scroll-behavior:auto !important;

    }

}
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {

    /* Fade-in Animation */

    const elements = document.querySelectorAll(
        ".section-header-step, .process-progress, .process-card-step, .process-cta"
    );

    const observer = new IntersectionObserver((entries) => {

        entries.forEach(entry => {

            if (entry.isIntersecting) {

                entry.target.classList.add("fade-in");

                observer.unobserve(entry.target);

            }

        });

    }, {
        threshold: 0.15
    });

    elements.forEach(el => observer.observe(el));



    /* Timeline Hover */

    const cards = document.querySelectorAll(".process-card-step");
    const steps = document.querySelectorAll(".step");

    cards.forEach((card, index) => {

        card.addEventListener("mouseenter", () => {

            steps.forEach(step => step.classList.remove("active"));

            if (steps[index]) {
                steps[index].classList.add("active");
            }

        });

    });

    /* Reset to Step 01 */

    cards.forEach(card => {

        card.addEventListener("mouseleave", () => {

            steps.forEach(step => step.classList.remove("active"));

            steps[0].classList.add("active");

        });

    });

});

document.querySelectorAll('.process-cta').forEach(cta => {

    cta.addEventListener('keydown', function(e){

        if(e.key === 'Enter' || e.key === ' '){

            e.preventDefault();

            Calendly.initPopupWidget({
                url: 'https://calendly.com/kimson-pomento-cwglobalpeople/30min?hide_gdpr_banner=1'
            });

        }

    });

});
</script>

