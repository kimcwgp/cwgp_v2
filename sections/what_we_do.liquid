<section 
  class="cwgp-services-card"
  style="
    background-color: {{ section.settings.section_bg_color }};
    padding-top: {{ section.settings.padding-block-start }}px;
    padding-bottom: {{ section.settings.padding-block-end }}px;
  "
>

    <div class="cwgp-container" style="max-width: {{ section.settings.section_max_width }}px;">

        <!-- Workforce -->
      {% for block in section.blocks %}
        {%- assign desc_opacity = block.settings.description_opacity | default: 100 | divided_by: 100.0 -%}
        {%- assign title_opacity = block.settings.title_opacity | default: 100 | divided_by: 100.0 -%}

            <div class="service-card">

                <div class="card-top">

                    <div class="card-content">

                        <h3
                        style="
                        color: {{ block.settings.cwgp_card_title_color | color_modify: 'alpha', title_opacity }} !important;
                        text-align: {{ block.settings.cwgp_card_title_alignment }};
                        font-size: {{ block.settings.title_size }}px;
                        font-weight: {{ block.settings.title_font_weight }} !important;
                        line-height: normal;
                        ">{{ block.settings.card_title }}</h3>

                        <span class="gold-line"></span>

                        {% if block.settings.cwgp_expertise_card_text != blank %}
                            <div 
                                class="cwgp-card-expertise-description"
                                style="
                                color: {{ block.settings.cwgp_card_description_color | color_modify: 'alpha', desc_opacity }} !important;
                                text-align: {{ block.settings.cwgp_card_description_alignment }} !important;
                                font-size: {{ block.settings.cwgp_card_description_size }}px !important;
                                font-weight: {{ block.settings.description_font_weight }} !important;
                                ">
                                {{ block.settings.cwgp_expertise_card_text }}
                            </div>
                        {% endif %}

                    </div>

                    {% if block.settings.card_image %}
                        <img
                            class="card-bg-image"
                            src="{{ block.settings.card_image | image_url: width: 1000 }}"
                            alt="{{ block.settings.card_title }}">
                    {% endif %}

                </div>

                <div class="service-grid">

                    <div class="service-item">
                        <div class="icon-circle">
                            👤
                        </div>

                        <div class="service-info">
                            <h3>AP Specialists</h3>
                            <p>
                                Reliable accounts payable support and processing.
                            </p>
                        </div>
                    </div>

                    <div class="service-item">
                        <div class="icon-circle">
                            ✏️
                        </div>

                        <div class="service-info">
                            <h3>Copywriting</h3>
                            <p>
                                Clear, compelling content that connects and converts.
                            </p>
                        </div>
                    </div>

                    <div class="service-item">
                        <div class="icon-circle">
                            ✨
                        </div>

                        <div class="service-info">
                            <h3>AI</h3>
                            <p>
                                AI-powered solutions to automate and optimize business
                                processes.
                            </p>
                        </div>
                    </div>

                    <div class="service-item">
                        <div class="icon-circle">
                            📣
                        </div>

                        <div class="service-info">
                            <h3>Marketing</h3>
                            <p>
                                Digital marketing strategies that build brand and drive
                                growth.
                            </p>
                        </div>
                    </div>

                    <div class="service-item">
                        <div class="icon-circle">
                            📊
                        </div>

                        <div class="service-info">
                            <h3>Finance</h3>
                            <p>
                                Financial analysis, reporting and strategic support.
                            </p>
                        </div>
                    </div>

                    <div class="service-item">
                        <div class="icon-circle">
                            👥
                        </div>

                        <div class="service-info">
                            <h3>HR Support</h3>
                            <p>
                                People operations and HR support to help your team thrive.
                            </p>
                        </div>
                    </div>

                    <div class="service-item">
                        <div class="icon-circle">
                            🖌️
                        </div>

                        <div class="service-info">
                            <h3>UI/UX</h3>
                            <p>
                                User-centered designs that deliver exceptional
                                experiences.
                            </p>
                        </div>
                    </div>

                </div>

            </div>
        {% endfor %}


        <!-- Consulting -->

        <div class="service-card">

            <div class="card-top">

                <div class="card-content">

                    <h2>
                        Consulting<br>
                        Solutions
                    </h2>

                    <span class="gold-line"></span>

                    <p>
                        Technology and business consulting to modernize your
                        operations and drive sustainable growth.
                    </p>

                </div>

                <div class="card-image">

                    <img src="images/consulting.png"
                        alt="Consulting">

                </div>

            </div>

            <div class="service-grid">

                <div class="service-item">

                    <div class="icon-circle gold">
                        🛍️
                    </div>

                    <div class="service-info">
                        <h3>Shopify</h3>
                        <p>
                            End-to-end Shopify solutions from setup to optimization.
                        </p>
                    </div>

                </div>

                <div class="service-item">

                    <div class="icon-circle gold">
                        🔗
                    </div>

                    <div class="service-info">
                        <h3>MuleSoft</h3>
                        <p>
                            Integration solutions that connect systems and streamline
                            workflows.
                        </p>
                    </div>

                </div>

                <div class="service-item">

                    <div class="icon-circle gold">
                        👥
                    </div>

                    <div class="service-info">
                        <h3>Coupa Admin</h3>
                        <p>
                            Coupa implementation, configuration and administration.
                        </p>
                    </div>

                </div>

                <div class="service-item">

                    <div class="icon-circle gold">
                        📈
                    </div>

                    <div class="service-info">
                        <h3>Adaptive Insights</h3>
                        <p>
                            Planning, budgeting and forecasting for smarter
                            decision-making.
                        </p>
                    </div>

                </div>

                <div class="service-item">

                    <div class="icon-circle gold">
                        N
                    </div>

                    <div class="service-info">
                        <h3>NetSuite</h3>
                        <p>
                            NetSuite implementation and business process optimization.
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<style>

    /* ==========================================
    VARIABLES
    ========================================== */

    :root{

        --primary:#17255A;
        --gold:#C79A45;

        --text:#555;
        --heading:#17255A;

        --card-bg:#ffffff;

        --border:#ececec;

        --shadow:
        0 8px 24px rgba(15,23,42,.05),
        0 20px 70px rgba(15,23,42,.08),
        0 60px 120px rgba(15,23,42,.04);

        --radius:24px;

        --transition:.35s ease;
    }

    /* ==========================================
    SECTION
    ========================================== */

    .cwgp-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        gap: 20px;
    }

    /* ==========================================
    CARD
    ========================================== */

    .service-card{

        background:
            linear-gradient(
                180deg,
                #ffffff 0%,
                #fcfcfd 55%,
                #f8f9fb 100%
            );

        border:1px solid rgba(23,37,90,.05);

        overflow:hidden;

        box-shadow:var(--shadow);

        transition:var(--transition);

        position:relative;

    }

    .service-card:hover{

        transform:translateY(-8px);

        box-shadow:
            0 30px 80px rgba(0,0,0,.10);

    }

    .service-card::before{

        content:"";

        position:absolute;

        width:500px;

        height:500px;

        right:-220px;

        top:-220px;

        border-radius:50%;

        background:

            radial-gradient(

                circle,

                rgba(199,154,69,.08),

                transparent 70%

            );

        pointer-events:none;

    }

    /* ==========================================
    TOP AREA
    ========================================== */

    .card-top {
        position: relative;
        min-height: 365px;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
    }


    /* subtle background glow */

    .card-top::before{

        content:"";

        position:absolute;

        inset:0;

        background:
            radial-gradient(
                circle at top left,
                rgba(23,37,90,.06),
                transparent 60%
            );

        pointer-events:none;

    }

    /* ==========================================
    CONTENT
    ========================================== */

    .card-content {
        position: relative;
        z-index: 2;
        width: 40%;
    }

    .card-content h2{
        letter-spacing:-1px;
    }

    .gold-line{

        display:block;

        width:65px;

        height:4px;

        border-radius:50px;

        margin:30px 0;

        background:var(--gold);

    }

    .card-content p{
        color: inherit !important;
    }

    /* ==========================================
    IMAGE
    ========================================== */

    .card-bg-image {
        width: 60%;
        height: 100%;
        object-fit: contain;
        object-position: right bottom;
    }


    .card-image img{

        width:100%;

        max-width:560px;

        display:block;

        user-select:none;

        pointer-events:none;

        transition:var(--transition);

    }

    .service-card:hover
    .card-image img{

        transform:scale(1.03);

    }

    /* ==========================================
    SERVICES GRID
    ========================================== */

    .service-grid{

        display:grid;

        grid-template-columns:repeat(2,1fr);

        border-top:1px solid var(--border);

    }

    /* ==========================================
    SERVICE ITEM
    ========================================== */

    .service-item{

        display:flex;

        align-items:flex-start;

        gap:18px;

        padding:34px 30px;

        min-height:150px;

        transition:var(--transition);

        position:relative;

    }

    /* vertical divider */

    .service-item:nth-child(odd){

        border-right:1px solid var(--border);

    }

    /* horizontal divider */

    .service-item:not(:nth-last-child(-n+2)){

        border-bottom:1px solid var(--border);

    }

    /* Last single item (UI/UX & NetSuite) */

    .service-item:last-child{

        border-bottom:none;

    }

    /* Hover */

    .service-item:hover{

        background:#fafbff;

    }

    /* ==========================================
    ICON
    ========================================== */

    .icon-circle{

        width:68px;

        height:68px;

        min-width:68px;

        border-radius:50%;

        background:#f4f5fb;

        display:flex;

        align-items:center;

        justify-content:center;

        font-size:30px;

        color:var(--primary);

        transition:var(--transition);

    }

    /* Consulting Icons */

    .icon-circle.gold{

        background:#fbf7ef;

        color:var(--gold);

    }

    /* Hover Effect */

    .service-item:hover .icon-circle{

        transform:translateY(-4px) scale(1.05);

        box-shadow:
            0 10px 25px rgba(0,0,0,.08);

    }

    .service-item:hover .icon-circle.gold{

        background:var(--gold);

        color:#ffffff;

    }

    /* ==========================================
    TEXT
    ========================================== */

    .service-info{

        flex:1;

    }

    .service-info h3{

        font-size:28px;

        color:var(--heading);

        margin-bottom:10px;

        font-weight:700;

        line-height:1.2;

    }

    .service-info p{

        font-size:18px;

        color:var(--text);

        line-height:1.7;

    }

    /* ==========================================
    CONSULTING CARD OVERRIDE
    ========================================== */

    .service-card:nth-child(2) .card-top::before{

        background:
            radial-gradient(
                circle at top right,
                rgba(199,154,69,.10),
                transparent 60%
            );

    }

    /* ==========================================
    IMAGE ALIGNMENT
    ========================================== */


    /* ==========================================
    SMOOTH TRANSITIONS
    ========================================== */

    .service-item,
    .service-info,
    .icon-circle,
    .card-image img{

        transition:all .35s ease;

    }

    .service-item:hover h3{

        color:var(--gold);

    }

    .service-item:hover p{

        color:#444;

    }
    /* ==========================================
    RESPONSIVE DESIGN
    ========================================== */

    /* Large Desktop */
    @media (max-width: 1400px){

        .container{
            max-width:1200px;
        }

        .card-content h2{
            font-size:48px;
        }

        .card-content p{
            font-size:20px;
        }

        .service-info h3{
            font-size:24px;
        }

    }

    /* Laptop */
    @media (max-width:1200px){

        .services-section{
            padding:70px 25px;
        }

        .container{

            grid-template-columns:1fr;
            gap:35px;

        }

        .card-top{

            min-height:320px;
            padding:45px 35px 0;

        }

        .card-content{

            width:45%;

        }

        .card-image{

            width:55%;

        }

        .card-content h2{

            font-size:44px;

        }

        .card-content p{

            font-size:18px;

        }

        .service-item{

            padding:28px 24px;

        }

    }

    /* Tablet Landscape */
    @media (max-width:992px){

        .services-section{

            padding:60px 20px;

        }

        .card-top{

            flex-direction:column;
            align-items:center;
            justify-content:center;
            text-align:center;
            padding:45px 30px;

        }

        .card-content{

            width:100%;

        }

        .gold-line{

            margin:25px auto;

        }

        .card-image{

            width:100%;
            margin-top:35px;
            justify-content:center;

        }

        .card-image img{

            max-width:420px;

        }

        .service-grid{

            grid-template-columns:1fr;

        }

        .service-item{

            border-right:none !important;
            border-bottom:1px solid var(--border);

        }

        .service-item:last-child{

            border-bottom:none;

        }

    }

    /* Tablet Portrait */
    @media (max-width:768px){

        .services-section{

            padding:50px 15px;

        }

        .card-top{

            min-height:auto;

        }

        .card-content h2{

            font-size:38px;

        }

        .card-content p{

            font-size:17px;
            line-height:1.8;

        }

        .service-item{

            gap:16px;
            padding:22px;

        }

        .icon-circle{

            width:58px;
            height:58px;
            min-width:58px;

            font-size:24px;

        }

        .service-info h3{

            font-size:22px;

        }

        .service-info p{

            font-size:16px;

        }

    }

    /* Mobile */
    @media (max-width:576px){

        .services-section{

            padding:40px 12px;

        }

        .service-card{

            border-radius:18px;

        }

        .card-top{

            padding:35px 20px;

        }

        .card-content h2{

            font-size:32px;

        }

        .gold-line{

            width:55px;

        }

        .card-content p{

            font-size:15px;

        }

        .card-image img{

            max-width:280px;

        }

        .service-item{

            flex-direction:column;
            align-items:flex-start;
            text-align:left;

        }

        .icon-circle{

            width:52px;
            height:52px;
            min-width:52px;

            font-size:22px;

        }

        .service-info h3{

            font-size:20px;

        }

        .service-info p{

            font-size:15px;

        }

    }

    /* ==========================================
    FADE IN ANIMATION
    ========================================== */

    .service-card{

        opacity:0;

        transform:translateY(60px);

    }

    .service-card.show{

        opacity:1;

        transform:translateY(0);

        transition:
            opacity .8s ease,
            transform .8s ease;

    }

    /* ==========================================
    SERVICE ITEM ANIMATION
    ========================================== */

    .service-card.show .service-item{

        animation:fadeUp .7s ease forwards;

    }

    .service-card.show .service-item:nth-child(2){ animation-delay:.08s; }
    .service-card.show .service-item:nth-child(3){ animation-delay:.16s; }
    .service-card.show .service-item:nth-child(4){ animation-delay:.24s; }
    .service-card.show .service-item:nth-child(5){ animation-delay:.32s; }
    .service-card.show .service-item:nth-child(6){ animation-delay:.40s; }
    .service-card.show .service-item:nth-child(7){ animation-delay:.48s; }

    .service-item{

        opacity:0;

    }

    /* ==========================================
    KEYFRAMES
    ========================================== */

    @keyframes fadeUp{

        from{

            opacity:0;

            transform:translateY(20px);

        }

        to{

            opacity:1;

            transform:translateY(0);

        }

    }

    /* ==========================================
    GOLD LINE ANIMATION
    ========================================== */

    .gold-line{

        transform-origin:left;

        transition:
            transform .35s ease,
            width .35s ease;

    }

    .service-card:hover .gold-line{

        width:90px;

    }

    /* ==========================================
    IMAGE ANIMATION
    ========================================== */

    .card-image img{

        transition:
            transform .45s ease;

    }

    /* ==========================================
    REDUCE MOTION
    ========================================== */

    @media (prefers-reduced-motion: reduce){

        *{

            animation:none !important;

            transition:none !important;

        }

    }
</style>

<script>
    /* ==========================================
    SERVICES SECTION
    ========================================== */

    document.addEventListener("DOMContentLoaded", () => {

        const cards = document.querySelectorAll(".service-card");
        const serviceItems = document.querySelectorAll(".service-item");

        /* ==========================
        CARD FADE IN
        ========================== */

        const observer = new IntersectionObserver((entries) => {

            entries.forEach(entry => {

                if (entry.isIntersecting) {

                    entry.target.classList.add("show");

                }

            });

        }, {
            threshold: 0.15
        });

        cards.forEach(card => observer.observe(card));

        /* ==========================
        STAGGER SERVICE ITEMS
        ========================== */

        serviceItems.forEach((item, index) => {

            item.style.transitionDelay = `${index * 70}ms`;

        });

        /* ==========================
        IMAGE PARALLAX
        ========================== */

        cards.forEach(card => {

            const image = card.querySelector(".card-image img");

            card.addEventListener("mousemove", (e) => {

                if (window.innerWidth < 992) return;

                const rect = card.getBoundingClientRect();

                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                const moveX = (x - rect.width / 2) / 40;
                const moveY = (y - rect.height / 2) / 40;

                image.style.transform =
                    `translate(${moveX}px, ${moveY}px) scale(1.03)`;

            });

            card.addEventListener("mouseleave", () => {

                image.style.transform =
                    "translate(0,0) scale(1)";

            });

        });

    });

</script>

